# Copy this file to  terraform.tfvars  and fill in your real values.
# terraform.tfvars is gitignored so your details never get committed.

aws_region    = "us-east-1"
instance_type = "t3.micro"
key_name      = "my-key"      # the name of your key pair in AWS (no .pem)
my_ip         = "149.40.241.90/32"      # your public IP — get it from https://ifconfig.me
repo_url      = "https://github.com/Abu-Hurairah-baig/backend.git"  # public repo cloned & run on boot
